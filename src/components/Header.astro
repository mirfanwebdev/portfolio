---
import Contact from "./Contact.astro";

interface Props {
  author: {
    name: string;
    role: string;
    description: string;
    photoUrl: string;
  };
}

const { author } = Astro.props;
---

<header>
  <div class="summary">
    <h1>{author.name}</h1>
    <h2>{author.role}</h2>
    <p>{author.description}</p>
  </div>
  <img src={author.photoUrl} alt={author.name} />
  <Contact />
</header>

<style lang="scss">
  header {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    justify-content: space-between;

    .summary {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin-bottom: 0;
      h1 {
        font-size: 3rem;
      }
      h2 {
        font-size: 1.5rem;
      }
      p {
        text-align: center;
        font-weight: 500;
      }

      img {
        align-self: center;
        margin-bottom: 0;
        border-radius: 50%;
        border: 4px solid var(--color-primary);

        &:hover {
          border-color: var(--highlight-primary);
        }
      }
    }
  }

  @media screen and (min-width: 1024px) {
    header {
      gap: 0;
      height: 70vh;

      .summary {
        align-items: flex-start;
        gap: 0.25rem;

        p {
          text-align: left;
        }
      }

      img {
        align-self: flex-start;
        margin-bottom: initial;
      }
    }
  }
</style>
